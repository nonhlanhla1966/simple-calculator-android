<?xml version="1.0" encoding="utf-8"?>
<!--
    Root vertical LinearLayout fills the whole screen.
    - Top section (weight 1):  display / result area
    - Bottom section (weight 2.2): five rows of calculator buttons

    IMPORTANT: every Button has its layout_width, layout_height, and layout_weight
    declared here directly — NOT in styles.xml — so they can never be shadowed by
    style inheritance or ambiguous parent-layout semantics.

    Buttons that are in a horizontal row use:
        layout_width  = 0dp  (filled by layout_weight in the horizontal parent)
        layout_height = match_parent  (fills the row's height)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/calc_background">

    <!-- ═══════════════════════════════════════════
         DISPLAY AREA
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="12dp">

        <!-- Expression preview: "12 + 5 =" -->
        <TextView
            android:id="@+id/textExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/calc_display_expression"
            android:textSize="22sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:contentDescription="@string/desc_expression_display" />

        <!-- Main result number -->
        <TextView
            android:id="@+id/textResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/calc_display_result"
            android:textSize="64sp"
            android:textStyle="bold"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="24sp"
            android:autoSizeMaxTextSize="64sp"
            android:text="0"
            android:contentDescription="@string/desc_result_display" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         BUTTON PAD  (5 equal-height rows)
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.2"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        android:paddingTop="4dp">

        <!-- Row 1: AC  ⌫  %  ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                style="@style/CalcButton.Function"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="@string/btn_clear"
                android:contentDescription="@string/desc_clear" />

            <Button
                android:id="@+id/btnBackspace"
                style="@style/CalcButton.Function"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="@string/btn_backspace"
                android:contentDescription="@string/desc_backspace" />

            <Button
                android:id="@+id/btnPercent"
                style="@style/CalcButton.Function"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="@string/btn_percent"
                android:contentDescription="@string/desc_percent" />

            <Button
                android:id="@+id/btnDivide"
                style="@style/CalcButton.Operator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="@string/btn_divide" />
        </LinearLayout>

        <!-- Row 2: 7  8  9  × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn7"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="7" />

            <Button
                android:id="@+id/btn8"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="8" />

            <Button
                android:id="@+id/btn9"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="9" />

            <Button
                android:id="@+id/btnMultiply"
                style="@style/CalcButton.Operator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="@string/btn_multiply" />
        </LinearLayout>

        <!-- Row 3: 4  5  6  − -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn4"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="4" />

            <Button
                android:id="@+id/btn5"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="5" />

            <Button
                android:id="@+id/btn6"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="6" />

            <Button
                android:id="@+id/btnSubtract"
                style="@style/CalcButton.Operator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="@string/btn_subtract" />
        </LinearLayout>

        <!-- Row 4: 1  2  3  + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn1"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="1" />

            <Button
                android:id="@+id/btn2"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="2" />

            <Button
                android:id="@+id/btn3"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="3" />

            <Button
                android:id="@+id/btnAdd"
                style="@style/CalcButton.Operator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="@string/btn_add" />
        </LinearLayout>

        <!-- Row 5: +/−  0  .  = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSign"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:textSize="18sp"
                android:text="@string/btn_sign"
                android:contentDescription="@string/desc_sign" />

            <Button
                android:id="@+id/btn0"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="0" />

            <Button
                android:id="@+id/btnDecimal"
                style="@style/CalcButton.Number"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="@string/btn_decimal" />

            <Button
                android:id="@+id/btnEquals"
                style="@style/CalcButton.Equals"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:text="@string/btn_equals" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
