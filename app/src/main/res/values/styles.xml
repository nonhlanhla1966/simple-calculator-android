<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        All button styles inherit from Widget.MaterialComponents.Button so that
        MaterialButton renders correctly (backgroundTint, rippleColor, cornerRadius
        all work as expected). Layout dimensions (width/height/weight) are NOT
        set here — they are set directly in activity_main.xml so they are never
        ambiguous regardless of which parent LinearLayout the button is in.
    -->

    <style name="CalcButton.Number" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/calc_number_bg</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="android:textColor">@color/calc_number_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CalcButton.Function" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/calc_function_bg</item>
        <item name="rippleColor">@color/ripple_dark</item>
        <item name="android:textColor">@color/calc_function_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CalcButton.Operator" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/calc_operator_bg</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="android:textColor">@color/calc_operator_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="CalcButton.Equals" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/calc_equals_bg</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="android:textColor">@color/calc_equals_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
