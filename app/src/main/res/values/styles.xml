<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        CalcButtonBase supplies the layout dimensions that all calculator buttons share.
        THE FIX: android:layout_height is "match_parent" (was "0dp").
        Buttons live inside horizontal LinearLayout rows. A height of 0dp with no
        height-weight in a horizontal context means zero visible height — the root
        cause of the "only a zero in the corner" bug. "match_parent" fills each row.
    -->
    <style name="CalcButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Number" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_button_number</item>
        <item name="android:textColor">@color/calc_number_text</item>
    </style>

    <style name="CalcButton.Operator" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_button_operator</item>
        <item name="android:textColor">@color/calc_operator_text</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="CalcButton.Function" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_button_function</item>
        <item name="android:textColor">@color/calc_function_text</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CalcButton.Equals" parent="CalcButtonBase">
        <item name="android:background">@drawable/bg_button_equals</item>
        <item name="android:textColor">@color/calc_equals_text</item>
        <item name="android:textSize">30sp</item>
    </style>

</resources>
